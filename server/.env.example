# Copy to .env and fill in real values. Never commit .env.
PORT=5000
# Local:  mongodb://127.0.0.1:27017/applytrack
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/applytrack
MONGO_URI=mongodb://127.0.0.1:27017/applytrack
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
